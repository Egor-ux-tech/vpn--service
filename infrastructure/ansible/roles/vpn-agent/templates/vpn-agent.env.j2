ENVIRONMENT=production
LOG_LEVEL=INFO
# Binds on all interfaces — reachability is controlled by the nftables allowlist
# (roles/wireguard restricts :{{ vpn_agent_port }} to backend_source_ip only), not the bind address.
AGENT_HOST=0.0.0.0
AGENT_PORT={{ vpn_agent_port }}
VPN_AGENT_SHARED_SECRET={{ vpn_agent_shared_secret }}
WG_INTERFACE=wg0
STATE_DB_PATH=/var/lib/vpn-agent/state.db
APPLY_TO_LIVE_INTERFACE=true
