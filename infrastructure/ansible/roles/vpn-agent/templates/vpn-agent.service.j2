## Managed by Ansible (roles/vpn-agent) — do not edit by hand.
[Unit]
Description=VPN Agent — WireGuard peer reconciliation service
After=network-online.target wg-quick@wg0.service
Wants=network-online.target
Requires=wg-quick@wg0.service

[Service]
Type=simple
User=vpn-agent
Group=vpn-agent
EnvironmentFile=/etc/vpn-agent/vpn-agent.env
ExecStart=/opt/vpn-service/vpn/.venv/bin/uvicorn app.main:app --app-dir /opt/vpn-service/vpn --host ${AGENT_HOST} --port ${AGENT_PORT}
Restart=on-failure
RestartSec=3

# The service runs as an unprivileged user; CAP_NET_ADMIN is the one capability it needs
# to run `wg`/`wg-quick` (see also roles/vpn-agent's capabilities task for the `wg` binary
# itself, which is the belt-and-suspenders equivalent for manual/non-systemd invocations).
AmbientCapabilities=CAP_NET_ADMIN
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/vpn-agent /etc/wireguard
ProtectHome=true

[Install]
WantedBy=multi-user.target
