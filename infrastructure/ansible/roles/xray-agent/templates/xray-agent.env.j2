ENVIRONMENT=production
LOG_LEVEL=INFO
# Binds on all interfaces — reachability is controlled by the nftables allowlist
# (roles/xray restricts :{{ xray_agent_port }} to backend_source_ip only), not the bind address.
AGENT_HOST=0.0.0.0
AGENT_PORT={{ xray_agent_port }}
XRAY_AGENT_SHARED_SECRET={{ xray_agent_shared_secret }}
XRAY_GRPC_ADDRESS=127.0.0.1:{{ xray_api_port }}
XRAY_INBOUND_TAG={{ xray_inbound_tag }}
STATE_DB_PATH=/var/lib/xray-agent/state.db
APPLY_TO_LIVE_XRAY=true
RECONCILIATION_INTERVAL_SECONDS={{ xray_reconciliation_interval_seconds }}
