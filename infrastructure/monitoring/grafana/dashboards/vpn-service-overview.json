{
  "title": "VPN Service Overview",
  "uid": "vpn-service-overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "utc",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "tags": ["vpn-service"],
  "panels": [
    {
      "id": 1,
      "title": "Active users",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [{ "expr": "vpn_active_users", "refId": "A" }]
    },
    {
      "id": 2,
      "title": "Active subscriptions",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [{ "expr": "vpn_active_subscriptions", "refId": "A" }]
    },
    {
      "id": 3,
      "title": "Active devices",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [{ "expr": "vpn_active_devices", "refId": "A" }]
    },
    {
      "id": 4,
      "title": "Online servers",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [{ "expr": "vpn_online_servers", "refId": "A" }]
    },
    {
      "id": 5,
      "title": "Online peers",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "targets": [{ "expr": "vpn_online_peers", "refId": "A" }]
    },
    {
      "id": 6,
      "title": "Bot errors (5m rate)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "targets": [{ "expr": "rate(bot_errors_total[5m])", "refId": "A" }]
    },
    {
      "id": 10,
      "title": "Backend API request rate by status",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sum by (status_code) (rate(http_requests_total{job=\"backend\"}[5m]))",
          "legendFormat": "{{status_code}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Backend API latency (p50/p95/p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"backend\"}[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"backend\"}[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"backend\"}[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "id": 12,
      "title": "API errors by code (5m rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "sum by (error_code) (rate(api_errors_total[5m]))",
          "legendFormat": "{{error_code}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "title": "Database query latency (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(db_query_duration_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    },
    {
      "id": 14,
      "title": "VPN provisioning errors (5m rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "sum by (operation) (rate(vpn_provisioning_errors_total[5m]))",
          "legendFormat": "{{operation}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 15,
      "title": "wg command errors by agent (5m rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        {
          "expr": "sum by (instance, command) (rate(wg_command_errors_total[5m]))",
          "legendFormat": "{{instance}} {{command}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 16,
      "title": "Enabled peers per vpn-agent",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "targets": [
        { "expr": "wg_enabled_peers", "legendFormat": "{{instance}}", "refId": "A" }
      ]
    },
    {
      "id": 17,
      "title": "Bot notification delivery outcomes (5m rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(bot_notify_requests_total[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    }
  ]
}
