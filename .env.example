# Copy to .env and fill in real values. NEVER commit the real .env file.

# ---- General ----
ENVIRONMENT=development        # development | staging | production
LOG_LEVEL=INFO
TZ=UTC

# ---- Backend / API ----
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# ---- Database ----
POSTGRES_USER=vpnservice
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vpnservice
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://vpnservice:change-me@postgres:5432/vpnservice

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- Auth / security ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
ADMIN_SECRET=change-me-admin-bootstrap-secret
INTERNAL_SERVICE_TOKEN=change-me-shared-secret-for-service-to-service-calls

# ---- Telegram bot ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=change-me
TELEGRAM_ADMIN_IDS=[]
# Internal HTTP surface the bot exposes for the backend to push notifications through
# (subscription expiry, payment confirmations, ...). Not reachable outside the Docker network.
NOTIFY_HOST=0.0.0.0
NOTIFY_PORT=8801
BOT_NOTIFY_BASE_URL=http://bot:8801

# ---- Payments (provider-agnostic; fill in the provider you enable) ----
PAYMENT_PROVIDER=mock          # mock | yookassa | cryptomus | stripe
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SHOP_ID=
PAYMENT_WEBHOOK_SECRET=change-me

# ---- VPN / WireGuard ----
VPN_DEFAULT_NETWORK=10.66.0.0/16
VPN_DNS=1.1.1.1,1.0.0.1
VPN_AGENT_SHARED_SECRET=change-me-vpn-agent-secret
VPN_AGENT_PORT=8800
WG_LISTEN_PORT=51820

# ---- Frontend (admin panel) ----
# Auth is the backend's own JWT (see AdminAuthService) — the admin panel calls
# /api/v1/auth/admin/login directly and holds the token itself; there is no NextAuth.js
# (or any other session layer) in this codebase.
# In production (docker-compose.prod.yml) this must be the real https://<API_DOMAIN>
# origin, since it's called from the browser — not the internal backend:8000 service name.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---- Production reverse proxy (docker-compose.prod.yml / infrastructure/caddy/Caddyfile) ----
# Only used by the production compose file — irrelevant for local dev (make up). Both
# domains must already resolve (A/AAAA) to this host before starting caddy, and ports
# 80+443 must be reachable from the internet, or Caddy's automatic HTTPS (Let's Encrypt)
# cannot issue a certificate. See docs/deployment.md.
API_DOMAIN=api.example.com
ADMIN_DOMAIN=admin.example.com
ACME_EMAIL=you@example.com

# ---- Monitoring ----
PROMETHEUS_METRICS_ENABLED=true
GRAFANA_ADMIN_PASSWORD=change-me
